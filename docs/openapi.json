  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "questionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Questionid"
          },
          "value": {
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionId",
          "value"
        ],
        "title": "Answer"
      },
      "Condition": {
        "properties": {
          "operator": {
            "type": "string",
            "maxLength": 30,
            "title": "Operator"
          },
          "operand": {
            "title": "Operand"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operator",
          "operand"
        ],
        "title": "Condition"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "DraftInput": {
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          },
          "settings": {
            "$ref": "#/components/schemas/VersionSettings"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Questions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expectedRevision",
          "questions"
        ],
        "title": "DraftInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Option": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "title": "Option"
      },
      "PublishInput": {
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedrevision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expectedRevision"
        ],
        "title": "PublishInput"
      },
      "Question": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "single_choice",
              "multiple_choice",
              "text",
              "number"
            ],
            "title": "Type"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": false
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Options"
          },
          "validation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Validation"
          },
          "routingRules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Routingrules"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "title"
        ],
        "title": "Question"
      },
      "Rule": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Priority"
          },
          "condition": {
            "$ref": "#/components/schemas/Condition"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "priority",
          "condition",
          "target"
        ],
        "title": "Rule"
      },
      "SubmissionInput": {
        "properties": {
          "surveyVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Surveyversion"
          },
          "requestId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Requestid"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/Answer"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "surveyVersion",
          "requestId",
          "answers"
        ],
        "title": "SubmissionInput"
      },
      "SurveyInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "anonymous": {
            "type": "boolean",
            "title": "Anonymous",
            "default": true
          },
          "submissionPolicy": {
            "type": "string",
            "enum": [
              "latest_only",
              "multiple"
            ],
            "title": "Submissionpolicy",
            "default": "latest_only"
          },
          "deadlineAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadlineat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "SurveyInput"
      },
      "SurveyPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "deadlineAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadlineat"
          },
          "submissionPolicy": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "latest_only",
                  "multiple"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Submissionpolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SurveyPatch"
      },
      "Target": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "question",
              "end"
            ],
            "title": "Kind"
          },
          "questionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Questionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Target"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionSettings": {
        "properties": {
          "anonymous": {
            "type": "boolean",
            "title": "Anonymous",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "VersionSettings"
      }
    }
  }
}
